import java.util.Scanner;

public class TrafficSignalStreakAnalyzer {

    static void findLongestStreak(String signalLog) {

        if (signalLog == null || signalLog.isEmpty()) {
            System.out.println("Signal log cannot be empty.");
            return;
        }

        int currentStreak = 1;
        int longestStreak = 1;

        char currentColor = signalLog.charAt(0);
        char longestColor = currentColor;

        for (int i = 1; i < signalLog.length(); i++) {

            char currentCharacter = signalLog.charAt(i);

            if (currentCharacter == signalLog.charAt(i - 1)) {
                currentStreak++;
            } else {
                currentStreak = 1;
            }

            if (currentStreak > longestStreak) {
                longestStreak = currentStreak;
                longestColor = currentCharacter;
            }
        }

        System.out.println(
                "Longest Streak: '"
                + longestColor
                + "' repeated "
                + longestStreak
                + " times"
        );
    }

    static boolean isValidSignalLog(String signalLog) {

        for (int i = 0; i < signalLog.length(); i++) {

            char signal = signalLog.charAt(i);

            if (signal != 'R' && signal != 'Y' && signal != 'G') {
                return false;
            }
        }

        return true;
    }

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);

        try {

            System.out.print(
                    "Enter signal log using R, Y, and G: "
            );

            String signalLog = scanner.nextLine()
                    .toUpperCase()
                    .trim();

            if (!isValidSignalLog(signalLog)) {
                System.out.println(
                        "Invalid signal log. Use only R, Y, and G."
                );
                return;
            }

            findLongestStreak(signalLog);

        } finally {
            scanner.close();
        }
    }
}
